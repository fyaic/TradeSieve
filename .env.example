# Reference Compose deployment. These values are intentionally demo-only.
COMPOSE_PROJECT_NAME=tradesieve-demo

# PostgreSQL bootstrap values used only by the local reference stack.
POSTGRES_USER=tradesieve
POSTGRES_PASSWORD=local_demo_only # pragma: allowlist secret
POSTGRES_DB=tradesieve

# TradeSieve runtime mode. Non-demo mode rejects every unsafe default below.
TRADESIEVE_MODE=demo
TRADESIEVE_DATABASE_URL=postgresql://tradesieve:local_demo_only@postgres:5432/tradesieve # pragma: allowlist secret
TRADESIEVE_DEBUG=false
TRADESIEVE_DEMO_BOOTSTRAP_ENABLED=true
TRADESIEVE_REQUIRED_SOURCE_SET=synthetic-demo-sources-v1
TRADESIEVE_REQUIRED_RULE_SET=synthetic-demo-rules-v1
# Directory containing the immutable alembic.ini and migrations/ shipped in the image.
TRADESIEVE_MIGRATION_ROOT=/app

# HTTP port must be 1..65535; every timeout/interval must be positive.
# The worker stale threshold must be greater than its heartbeat interval.
TRADESIEVE_HTTP_HOST=0.0.0.0
TRADESIEVE_HTTP_PORT=8080
TRADESIEVE_HOST_PORT=8080
TRADESIEVE_DATABASE_CONNECT_TIMEOUT_SECONDS=2
TRADESIEVE_WORKER_HEARTBEAT_SECONDS=2
TRADESIEVE_WORKER_STALE_AFTER_SECONDS=10
